<?xml version="1.0" encoding="utf-8"?>
<!--
  Resonance MSIX package manifest.

  BEFORE PACKING: replace the three REPLACE-* values with the ones
  Partner Center shows for the reserved app (Partner Center > Resonance
  > Product management > Product identity). They must match EXACTLY,
  character for character, or the Store will reject the upload.
  See ../STORE.md for the full walkthrough.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="REPLACE-WITH-IDENTITY-NAME"
    Publisher="CN=REPLACE-WITH-PUBLISHER-ID"
    Version="1.0.0.0" />

  <Properties>
    <DisplayName>Resonance</DisplayName>
    <PublisherDisplayName>REPLACE-WITH-PUBLISHER-DISPLAY-NAME</PublisherDisplayName>
    <Logo>assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
    <!-- windows-reactor runs on WinUI 3, which ships in the Windows App
         Runtime 2.x framework package. Declaring the dependency makes
         Windows install it automatically wherever it is missing. -->
    <PackageDependency Name="Microsoft.WindowsAppRuntime.2" MinVersion="2.0.0.0" Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Resonance" Executable="resonance.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Resonance"
        Description="Resonance - music streaming"
        BackgroundColor="transparent"
        Square150x150Logo="assets\Square150x150Logo.png"
        Square44x44Logo="assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="assets\Wide310x150Logo.png" Square310x310Logo="assets\Square310x310Logo.png" />
        <uap:SplashScreen Image="assets\Square150x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Streaming, downloads and the image cache all need the network. -->
    <Capability Name="internetClient" />
    <!-- A packaged Win32 (full-trust) executable. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
